                        <input id="lojinha-cep" type="text" placeholder="00000-000" required maxlength="9" class="bg-surface border border-outline-variant rounded-xl px-4 py-3 outline-none focus:border-primary w-full text-sm font-body-md text-center text-lg tracking-widest">
                    </div>
                    <button type="submit" class="w-full bg-primary text-on-primary font-label-lg text-sm uppercase tracking-widest py-4 rounded-full hover:opacity-90 transition-all font-bold mt-2 shadow-md">
                        Ativar Minha Lojinha
                    </button>
                </form>
            </div>

            <div id="lojinha-dashboard" class="hidden flex flex-col gap-6">
                <div class="flex flex-col md:flex-row gap-4 items-center justify-between bg-surface-container rounded-3xl p-6 border border-outline-variant shadow-sm">
                    <div>
                        <h2 class="font-headline-xl text-2xl text-on-background">Painel do Vendedor</h2>
                        <p class="font-label-sm text-xs font-bold uppercase tracking-widest text-primary mt-1">Status: Loja Ativa</p>
                    </div>
                    <button onclick="window.location.href='/vender'" class="w-full md:w-auto bg-primary text-on-primary font-label-lg text-xs uppercase tracking-widest py-3 px-6 rounded-full hover:opacity-90 transition-all font-bold flex items-center justify-center gap-2 shadow-md">
                        <span class="material-symbols-outlined text-[18px]">add_circle</span> Anunciar Peça
                    </button>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                     <div id="card-ativas" class="bg-surface-container-low rounded-3xl p-4 md:p-6 border border-outline-variant flex flex-col items-center justify-center text-center cursor-pointer hover:border-primary hover:shadow-md transition-all group">
                        <span class="font-label-lg text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2 group-hover:text-primary transition-colors">Anúncios Ativos</span>
                        <span id="metric-ativas" class="font-headline-xl text-3xl md:text-4xl text-on-background group-hover:text-primary transition-colors">0</span>
                        <span class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant mt-2 opacity-0 group-hover:opacity-100 transition-opacity">Ver Peças &rarr;</span>
                     </div>
                     <div id="card-valor-estoque" class="bg-surface-container-low rounded-3xl p-4 md:p-6 border border-outline-variant flex flex-col items-center justify-center text-center cursor-pointer hover:border-primary hover:shadow-md transition-all group">
                        <span class="font-label-lg text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2 group-hover:text-primary transition-colors">Valor Anunciado</span>
                        <span id="metric-valor-estoque" class="font-headline-xl text-xl md:text-2xl text-on-background group-hover:text-primary transition-colors mt-2">R$ 0,00</span>
                        <span class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant mt-2 opacity-0 group-hover:opacity-100 transition-opacity">Gerenciar &rarr;</span>
