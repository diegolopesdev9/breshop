                    </button>
                    <button id="btn-excluir-conta" type="button" class="flex-1 bg-error/10 border border-error/20 text-error font-label-lg text-xs font-bold uppercase tracking-widest py-4 rounded-xl hover:bg-error hover:text-white transition-colors flex items-center justify-center gap-2 shadow-sm">
