                    <button id="close-modal-vendas" class="text-on-surface-variant hover:text-error bg-surface rounded-full p-2 border border-outline-variant shadow-sm transition-colors">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div id="vendas-lista" class="flex-1 overflow-y-auto p-6 flex flex-col gap-4 scrollbar-hide">
                </div>
            </div>
        </div>

    </main>

    <script type="module" src="/src/js/minha-conta.js"></script>
