<body class="antialiased bg-background text-on-background font-body-md overflow-x-hidden flex flex-col min-h-screen">
    <main class="pt-[100px] pb-24 max-w-4xl mx-auto px-4 md:px-8 flex-1 w-full">
        <div class="mb-10 border-b border-outline-variant pb-6">
            <h1 class="font-headline-xl text-4xl md:text-5xl text-on-background mb-4">Fale Conosco.</h1>
            <p class="font-label-sm text-xs text-on-surface-variant uppercase tracking-widest font-bold">Estamos aqui para ajudar</p>
        </div>
        <div class="bg-surface-container rounded-3xl p-6 md:p-10 border border-outline-variant shadow-sm space-y-6 text-center md:text-left">
